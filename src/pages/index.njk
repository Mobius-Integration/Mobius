      { name: "WordPress", icon: "wordpress" }, { name: "Wix", icon: "wix" },
      { name: "Squarespace", icon: "squarespace" }, { name: "Shopify", icon: "shopify" },
      { name: "Google Business Profile" }, { name: "Square", icon: "square" },
