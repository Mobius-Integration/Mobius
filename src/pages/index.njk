<!-- 5. Prices -->
<section class="section bg-white" aria-labelledby="packages-heading">
  <div class="wrap">
    <h2 id="packages-heading" class="h-section mb-3 text-center">What it costs, starting at</h2>
    <p class="lede mx-auto mb-10 max-w-2xl text-center">Most fixes are a one-time job. The monthly plan is optional. Every price is in writing before any work starts.</p>
    {% set showIds = ["tuneup", "sprint", "launch", "partner"] %}
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {% for package in packages.all %}
      {% if package.id in showIds %}
      <li class="card flex flex-col p-6 md:p-6">
        <h3 class="mb-2 text-lg font-bold text-gray-900">{{ package.name }}</h3>
        <p class="text-3xl font-extrabold text-gray-900">{{ package.price }}</p>
        <p class="mb-4 text-sm text-gray-700">{{ package.priceNote }}</p>
        <p class="flex-1 text-gray-700">{{ package.tagline }}</p>
      </li>
      {% endif %}
      {% endfor %}
    </ul>
    <p class="mt-8 text-center"><a href="/pricing/" class="link font-semibold">See every package and what each one includes</a></p>
  </div>
</section>

