{% set checkupTimeline %}{% for p in packages.all %}{% if p.id == "checkup" %}{{ p.timeline }}{% endif %}{% endfor %}{% endset %}

{# One list drives both the visible questions and the FAQPage JSON-LD, so they cannot drift apart. Answers are plain text. #}
{% set groups = [
  { id: "working", title: "Working with Mobius" },
  { id: "money", title: "Pricing and contracts" },
  { id: "access", title: "Accessibility and health information" },
  { id: "practical", title: "Location, support and ownership" }
] %}

