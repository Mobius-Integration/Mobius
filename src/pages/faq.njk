<section class="section bg-white">
  <div class="wrap-narrow">
    <p class="eyebrow">FAQ</p>
    <h1 class="mt-4 text-4xl font-medium leading-tight tracking-tight text-gray-900 md:text-5xl">Frequently asked questions</h1>
    <p class="lede mt-6">Short, honest answers to what local business owners ask us most. If yours isn't here, <a class="link" href="/contact/">send us a message</a>.</p>

    {% for group in groups %}
    <h2 class="h-section mt-14">{{ group.title }}</h2>
    <div class="mt-6 space-y-4">
      {% for f in faqs %}{% if f.g == group.id %}
      <details class="card-muted">
        <summary class="cursor-pointer text-lg font-medium text-gray-900">{{ f.q }}</summary>
        <p class="mt-4 text-gray-700">{{ f.a }}</p>
        {% if f.link %}<p class="mt-3"><a class="link font-medium" href="{{ f.link.href }}">{{ f.link.label }}</a></p>{% endif %}
      </details>
      {% endif %}{% endfor %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="section band-dark on-dark">
  <div class="wrap-narrow text-center">
    <h2 class="text-3xl font-medium text-white md:text-4xl">Still have a question?</h2>
    <p class="mt-4 text-lg text-gray-100">Bring it to the free checkup. It's a 20-minute call, and we'll answer it about your business.</p>
    <a class="btn-light mt-8" href="{{ site.writeupCta.href }}">Get my free website write-up</a>
  </div>
</section>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faqs %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | dump | safe }} } }{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
