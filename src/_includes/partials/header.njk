<header class="sticky top-0 z-50 border-b border-gray-200 bg-white">
  <div class="local-rule" aria-hidden="true"></div>
  <div class="container mx-auto px-4 py-2">
    <div class="flex flex-wrap items-center justify-between gap-x-6">
      <a href="/" class="flex min-h-[44px] items-center" aria-label="Mobius Integration home">
        <img src="/assets/img/logo-mark.svg" alt="" width="60" height="36" class="h-9 w-auto" />
        <span class="ml-2.5 text-lg leading-none tracking-tight text-gray-900"><span class="font-bold">mobius</span> <span class="font-light">integration</span></span>
      </a>
      <button type="button" id="menuBtn" class="hidden min-h-[44px] min-w-[44px] items-center justify-center gap-2 rounded-lg px-3 font-medium text-gray-800 hover:text-gulf-800 lg:hidden" aria-expanded="false" aria-controls="site-nav">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span>Menu</span>
      </button>
      <nav id="site-nav" aria-label="Main" class="flex w-full flex-col gap-1 border-t border-gray-200 py-3 lg:w-auto lg:flex-row lg:items-center lg:gap-1 lg:border-0 lg:py-0">
        {%- for item in site.nav %}
        {%- set isCurrent = (page.url == item.href) %}
        <a href="{{ item.href }}"{% if isCurrent %} aria-current="page"{% endif %} class="inline-flex min-h-[44px] items-center rounded-lg px-2 text-sm {% if isCurrent %}font-medium text-gulf-800 underline decoration-2 underline-offset-8{% else %}font-normal text-gray-700 hover:text-gulf-800 hover:underline hover:underline-offset-8{% endif %}">{{ item.label }}</a>
        {%- endfor %}
        <a href="{{ site.writeupCta.href }}"{% if page.url == site.writeupCta.href %} aria-current="page"{% endif %} class="btn-primary mt-2 text-sm lg:ml-2 lg:mt-0">{{ site.writeupCta.label }}</a>
      </nav>
    </div>
  </div>
</header>
<script>
  (function () {
    var btn = document.getElementById('menuBtn');
    var nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    // Progressive enhancement: without JavaScript the nav stays visible and the button stays hidden.
    btn.classList.remove('hidden');
    btn.classList.add('inline-flex');
    nav.classList.add('hidden', 'lg:flex');
    function setOpen(open) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      nav.classList.toggle('hidden', !open);
    }
    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
