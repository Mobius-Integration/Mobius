---
layout: base
---
<section class="section">
  <article class="wrap-narrow">
    <header>
      <p class="text-sm text-gray-600">
        <a href="/blog/" class="link">Blog</a>
      </p>
      <h1 class="mt-3 text-3xl font-medium leading-tight tracking-tight text-gray-900 md:text-5xl">{{ title }}</h1>
      <p class="mt-4 text-sm text-gray-600">
        <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
        <span aria-hidden="true">&middot;</span>
        By the {{ site.title }} team
      </p>
    </header>

    <div class="prose prose-lg mt-8 max-w-3xl prose-headings:font-medium prose-headings:text-gray-900 prose-p:text-gray-800 prose-li:text-gray-800 prose-a:font-medium prose-a:text-gulf-700 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-gulf-900">
      {{ content | safe }}
    </div>

    <aside class="card-muted mt-14" aria-labelledby="post-cta-heading">
      <h2 id="post-cta-heading" class="text-2xl font-medium text-gray-900">Want us to look at your site?</h2>
      <p class="mt-3 text-gray-700">The Free Tech Checkup is a 20-minute call plus a written scan of your website, booking flow and Google presence. You get a plain-English list of what to fix first, and there is no obligation.</p>
      <p class="mt-6">
        <a href="{{ site.writeupCta.href }}" class="btn-primary">Get my free website write-up</a>
      </p>
      <p class="mt-6 text-sm">
        <a href="/blog/" class="link">Back to all blog posts</a>
      </p>
    </aside>
  </article>
</section>
